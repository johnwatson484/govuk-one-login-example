{
  "name": "hapi-template-ts",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --env-file-if-exists=.env --watch --watch-path=./src src/index.ts",
    "dev:debug": "NODE_ENV=development node --env-file-if-exists=.env --watch --watch-path=./src --inspect src/index.ts",
    "docker:build": "docker compose --profile app build",
    "docker:dev": "docker compose --profile app up",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "local": "npm run dev",
    "start": "NODE_ENV=production node src/index.ts",
    "test": "npm run typecheck && cross-env TZ=UTC vitest run --coverage",
    "test:unit": "cross-env TZ=UTC vitest run --coverage --project unit --passWithNoTests",
    "test:integration": "cross-env TZ=UTC vitest run --coverage --project integration",
    "test:watch": "cross-env TZ=UTC vitest",
    "test:debug": "cross-env TZ=UTC vitest --inspect --no-file-parallelism",
    "typecheck": "tsc"
  },
  "author": "John Watson",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@hapi/boom": "10.0.1",
    "@hapi/crumb": "9.0.1",
    "@hapi/hapi": "21.4.9",
    "@hapi/inert": "7.1.1",
    "@hapi/scooter": "8.0.0",
    "@hapi/vision": "7.0.3",
    "blankie": "5.0.0",
    "convict": "6.2.5",
    "convict-format-with-validator": "6.2.0",
    "hapi-pino": "12.1.0",
    "hapi-pulse": "4.0.0",
    "joi": "18.2.1",
    "nunjucks": "3.2.4",
    "pino": "8.21.0"
  },
  "devDependencies": {
    "@types/convict": "6.1.6",
    "@types/convict-format-with-validator": "6.0.5",
    "@types/hapi__crumb": "7.3.7",
    "@types/node": "22.13.10",
    "@types/nunjucks": "3.2.6",
    "@vitest/coverage-v8": "4.1.8",
    "blipp": "4.0.2",
    "cross-env": "7.0.3",
    "eslint": "9.39.1",
    "neostandard": "0.11.4",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
