{% set cspNonce = nonce %}

{% extends "govuk/template.njk" %}

{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/phase-banner/macro.njk" import govukPhaseBanner %}
{% from "govuk/components/service-navigation/macro.njk" import govukServiceNavigation %}

{% block pageTitle %}{% if errors %}Error: {% endif %}{% if pageTitle and pageTitle != serviceName %}{{ pageTitle }} - {% endif %}{{ serviceName }} - GOV.UK{% endblock %}

{% block head %}
  <link rel="stylesheet" href="{{ assetPath }}/govuk-frontend.min.css">
  <link rel="stylesheet" href="{{ assetPath }}/site.css">
{% endblock %}

{% block govukServiceNavigation %}
  {{ govukServiceNavigation({
    serviceName: serviceName,
    serviceUrl: "/",
    navigation: navigation
  }) }}
{% endblock %}

{% block beforeContent %}
  {{ govukPhaseBanner({
    tag: { text: "Alpha" },
    html: 'This is an example service. It is not a real way to manage a farming business.'
  }) }}
  {% if backLink %}
    {{ govukBackLink({ href: backLink, text: "Back" }) }}
  {% endif %}
{% endblock %}

{% block bodyEnd %}
  <script type="module" nonce="{{ cspNonce }}">
    import { initAll } from '{{ assetPath }}/govuk-frontend.min.js'
    initAll()
  </script>
{% endblock %}
