{% extends '_layout.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/tag/macro.njk" import govukTag %}

{% set pageTitle = 'Your businesses' %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l">Your businesses</h1>

      {% if organisations.length %}
        <table class="govuk-table">
          <caption class="govuk-table__caption govuk-visually-hidden">Businesses you are linked to</caption>
          <thead class="govuk-table__head">
            <tr class="govuk-table__row">
              <th scope="col" class="govuk-table__header">Business</th>
              <th scope="col" class="govuk-table__header">SBI</th>
              <th scope="col" class="govuk-table__header">Your permission</th>
            </tr>
          </thead>
          <tbody class="govuk-table__body">
            {% for organisation in organisations %}
              <tr class="govuk-table__row">
                <td class="govuk-table__cell">
                  <a class="govuk-link" href="/organisations/{{ organisation.id }}">{{ organisation.name }}</a>
                </td>
                <td class="govuk-table__cell">{{ organisation.sbi }}</td>
                <td class="govuk-table__cell">
                  {% if organisation.permission == "owner" %}
                    {{ govukTag({ text: "Owner" }) }}
                  {% else %}
                    {{ govukTag({ text: "Member", classes: "govuk-tag--grey" }) }}
                  {% endif %}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      {% else %}
        <p class="govuk-body">You are not linked to any businesses yet.</p>
        <p class="govuk-body">Create one to get started, or ask an owner to invite you to theirs.</p>
      {% endif %}

      {{ govukButton({ text: "Create a business", href: "/organisations/create" }) }}
    </div>
  </div>
{% endblock %}
