{% extends '_layout.njk' %}

{% set pageTitle = 'This invitation was sent to a different email address' %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l">This invitation was sent to a different email address</h1>
      <p class="govuk-body">
        You are signed in with a different email address to the one the invitation was sent to.
      </p>
      <p class="govuk-body">
        Sign out and sign back in with the invited account, or ask an owner of the business to invite
        your email address instead.
      </p>
      <p class="govuk-body"><a class="govuk-link" href="/sign-out">Sign out</a></p>
    </div>
  </div>
{% endblock %}
