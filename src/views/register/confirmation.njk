{% extends '_layout.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/panel/macro.njk" import govukPanel %}

{% set pageTitle = 'Your details have been saved' %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {{ govukPanel({ titleText: "Your details have been saved" }) }}

      <h2 class="govuk-heading-m">What happens next</h2>
      <p class="govuk-body">You can now create a farming business, or accept an invitation to join one.</p>

      {{ govukButton({ text: "Continue", href: continueUrl }) }}
    </div>
  </div>
{% endblock %}
