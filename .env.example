# Loaded by `node --env-file-if-exists=.env` in dev scripts. In deployed
# environments no .env is present, so the flag is a no-op and real platform
# env vars always win. NEVER rely on .env in tests (inject via vitest config instead).
#
# Docker compose also reads .env, so the same file configures the dependency containers.
# `npm run keys:generate` copies this file to .env and fills in the generated values.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# GOV.UK One Login. The simulator listens on 3005 so it does not clash with the app.
ONE_LOGIN_CLIENT_ID=farming-business-service
ONE_LOGIN_DISCOVERY_URL=http://localhost:3005/.well-known/openid-configuration
ONE_LOGIN_REDIRECT_URL=http://localhost:3000/auth/callback
ONE_LOGIN_POST_LOGOUT_REDIRECT_URL=http://localhost:3000/signed-out

# Generated by `npm run keys:generate`. Local development only, never commit real values.
ONE_LOGIN_PRIVATE_KEY=
ONE_LOGIN_PUBLIC_KEY=
COOKIE_PASSWORD=

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=farming_accounts
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
